# Copy to .env for local runs. Never commit real keys.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional overrides
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Who the stdio MCP server acts as (in production this comes from SSO)
ACCESSPILOT_USER=priya.sharma
